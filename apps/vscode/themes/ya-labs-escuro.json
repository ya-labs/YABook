    "editorWidget.background": "#292c31",
    "editorWidget.border": "#41464e",
    "editorGroupHeader.tabsBackground": "#17191c",
    "editorGroup.border": "#41464e",
    "tab.activeBackground": "#202226",
    "tab.inactiveBackground": "#17191c",
    "tab.border": "#41464e",
    "tab.activeForeground": "#eef1f5",
    "tab.inactiveForeground": "#b6beca",
    "tab.activeBorderTop": "#f2bf3e",
    "activityBar.background": "#17191c",
    "activityBar.foreground": "#eef1f5",
    "activityBar.inactiveForeground": "#8e97a5",
    "activityBar.activeBorder": "#f2bf3e",
    "activityBarBadge.background": "#f2bf3e",
