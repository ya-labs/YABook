  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#637777",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#d9f5dd",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#ecc48d",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f78c6c",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character.escape",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ff5874",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#ffcb8b",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d6deeb",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "meta.definition.variable variable.other.constant"
      ],
      "settings": {
        "foreground": "#9ad1ff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "support.variable"
      ],
      "settings": {
        "foreground": "#c5e478",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.method.declaration storage.type"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.method.declaration storage.type.property"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.language.this",
        "variable.language"
      ],
      "settings": {
        "foreground": "#7fdbca",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.object",
        "support.variable.object"
      ],
      "settings": {
        "foreground": "#c5e478",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#faf39f",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "meta.property-name",
        "meta.definition.property variable.object.property"
      ],
      "settings": {
        "foreground": "#baebe2",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#caece6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#addb67",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#82b1ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#addb67",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d6deeb",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ff869a",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#addb67",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#ff5874",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": false
}
