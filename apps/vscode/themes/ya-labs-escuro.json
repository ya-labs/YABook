    "widget.border": "#41464e",
    "selection.background": "#3a4a66",
    "icon.foreground": "#b6beca",
    "textLink.foreground": "#a7c2ee",
    "textLink.activeForeground": "#a7c2ee",
    "button.background": "#a7c2ee",
    "button.foreground": "#111b2b",
    "button.hoverBackground": "#96c3ff",
    "badge.background": "#f2bf3e",
    "badge.foreground": "#111b2b",
    "input.background": "#25282d",
    "input.border": "#41464e",
    "input.foreground": "#eef1f5",
    "dropdown.background": "#292c31",
    "dropdown.border": "#41464e",
    "editor.background": "#202226",
    "editor.foreground": "#eef1f5",
    "editorLineNumber.foreground": "#8e97a5",
    "editorLineNumber.activeForeground": "#eef1f5",
    "editor.lineHighlightBackground": "#25282d",
    "editor.selectionBackground": "#3a4a66",
    "editor.inactiveSelectionBackground": "#363b43",
    "editorCursor.foreground": "#a7c2ee",
    "editorIndentGuide.background1": "#41464e",
