    "statusBar.background": "#f4f5f7",
    "statusBar.foreground": "#515c6c",
    "statusBar.border": "#d9dee5",
    "statusBar.noFolderBackground": "#f4f5f7",
    "statusBarItem.remoteBackground": "#294f9d",
    "statusBarItem.remoteForeground": "#ffffff",
    "panel.background": "#ffffff",
    "panel.border": "#d9dee5",
    "panelTitle.activeBorder": "#f2bf3e",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#26303c",
    "terminal.ansiBlue": "#1d52c2",
    "terminal.ansiGreen": "#116844",
    "terminal.ansiYellow": "#8b5500",
    "terminal.ansiRed": "#b42c47",
    "terminal.ansiMagenta": "#6545b3",
    "terminal.ansiCyan": "#294f9d",
    "diffEditor.insertedTextBackground": "#1168441f",
    "diffEditor.insertedLineBackground": "#11684412",
    "diffEditor.removedTextBackground": "#b42c471f",
    "diffEditor.removedLineBackground": "#b42c4712",
    "gitDecoration.addedResourceForeground": "#116844",
    "gitDecoration.modifiedResourceForeground": "#1d52c2",
    "gitDecoration.deletedResourceForeground": "#b42c47",
    "gitDecoration.untrackedResourceForeground": "#116844",
    "editorError.foreground": "#b42c47",
    "editorWarning.foreground": "#8b5500",
    "editorInfo.foreground": "#1d52c2",
