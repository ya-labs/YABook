  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#989fb1",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#994cc3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#994cc3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#403f53",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#c96765",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#aa0982",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character.escape",
        "support.constant"
      ],
      "settings": {
        "foreground": "#bc5454",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.method-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4876d6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#111111",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#403f53",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "meta.definition.variable variable.other.constant"
      ],
      "settings": {
        "foreground": "#2f86b8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "support.variable"
      ],
      "settings": {
        "foreground": "#4f7b25",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.method.declaration storage.type"
      ],
      "settings": {
        "foreground": "#4876d6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.method.declaration storage.type.property"
      ],
      "settings": {
        "foreground": "#994cc3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.language.this",
        "variable.language"
      ],
      "settings": {
        "foreground": "#0c969b",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.object",
        "support.variable.object"
      ],
      "settings": {
        "foreground": "#4f7b25",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#8b5500",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "meta.property-name",
        "meta.definition.property variable.object.property"
      ],
      "settings": {
        "foreground": "#0c969b",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#994cc3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4876d6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#4876d6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#4876d6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#403f53",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#c96765",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4876d6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#bc5454",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": false
}
