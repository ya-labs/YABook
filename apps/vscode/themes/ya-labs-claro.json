    "icon.foreground": "#515c6c",
    "textLink.foreground": "#294f9d",
    "textLink.activeForeground": "#294f9d",
    "button.background": "#294f9d",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1d52c2",
    "badge.background": "#f2bf3e",
    "badge.foreground": "#111b2b",
    "input.background": "#eff1f4",
    "input.border": "#d9dee5",
    "input.foreground": "#26303c",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#d9dee5",
    "editor.background": "#ffffff",
    "editor.foreground": "#26303c",
    "editorLineNumber.foreground": "#5f6b7c",
