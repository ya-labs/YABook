{
  "name": "yabook",
  "displayName": "YABook",
  "description": "Alterações do agente em uma aba de diff com explicação por bloco, página de cada comando do YABook e atalhos para o Tasks e o mapa de memória.",
  "version": "0.4.0",
  "publisher": "yalabs",
  "icon": "media/icon.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "yabook.diff.abrir",
        "title": "Ver alterações da última sessão",
        "category": "YABook",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "yabook.diff.escolher",
        "title": "Escolher sessão de diff",
        "category": "YABook",
        "icon": "$(list-selection)"
      },
      {
        "command": "yabook.diff.explicacoes",
        "title": "Navegar pelas explicações do diff",
        "category": "YABook",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "yabook.diff.limparExplicacoes",
        "title": "Ocultar explicações do diff",
        "category": "YABook",
        "icon": "$(comment-unresolved)"
      },
      {
        "command": "yabook.diff.atualizar",
        "title": "Atualizar sessões",
        "category": "YABook",
        "icon": "$(refresh)"
      },
      {
        "command": "yabook.diff.abrirSessao",
        "title": "Abrir todas as alterações",
        "category": "YABook",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "yabook.diff.abrirArquivo",
        "title": "Abrir diff do arquivo",
        "category": "YABook"
      },
      {
        "command": "yabook.tasks.site",
        "title": "Abrir YABook Tasks no navegador",
        "category": "YABook",
        "icon": "$(checklist)"
      },
      {
        "command": "yabook.memoria.mapa",
        "title": "Abrir mapa de memória no navegador",
        "category": "YABook",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "yabook.ajuda.abrir",
        "title": "Abrir ajuda",
        "category": "YABook",
        "icon": "$(book)"
      },
      {
        "command": "yabook.ajuda.copiar",
        "title": "Copiar comando",
        "category": "YABook",
        "icon": "$(copy)"
      },
      {
        "command": "yabook.ajuda.atualizar",
        "title": "Atualizar comandos",
        "category": "YABook",
        "icon": "$(refresh)"
      },
      {
        "command": "yabook.comandos.abrir",
        "title": "Abrir explicação do comando",
        "category": "YABook"
      },
      {
        "command": "yabook.comandos.escolher",
        "title": "Explicar um comando do YABook",
        "category": "YABook",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yabook.diff.abrirSessao",
          "when": "false"
        },
        {
          "command": "yabook.diff.abrirArquivo",
          "when": "false"
        },
        {
          "command": "yabook.ajuda.copiar",
          "when": "false"
        },
        {
          "command": "yabook.comandos.abrir",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "yabook.diff.abrir",
          "when": "view == yabook.sessoes",
          "group": "navigation@1"
        },
        {
          "command": "yabook.diff.explicacoes",
          "when": "view == yabook.sessoes",
          "group": "navigation@1"
        },
        {
          "command": "yabook.diff.atualizar",
          "when": "view == yabook.sessoes",
          "group": "navigation@2"
        },
        {
          "command": "yabook.ajuda.abrir",
          "when": "view == yabook.ajuda",
          "group": "navigation@1"
        },
        {
          "command": "yabook.comandos.escolher",
          "when": "view == yabook.comandos",
          "group": "navigation@1"
        },
        {
          "command": "yabook.ajuda.atualizar",
          "when": "view == yabook.comandos",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "yabook.diff.abrirSessao",
          "when": "view == yabook.sessoes && viewItem == sessao",
          "group": "inline"
        },
        {
          "command": "yabook.ajuda.copiar",
          "when": "view == yabook.comandos && viewItem == comando",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yabook",
          "title": "YABook",
          "icon": "media/yabook.svg"
        }
      ]
    },
    "views": {
      "yabook": [
        {
          "id": "yabook.ajuda",
          "name": "Ajuda e atalhos"
        },
        {
          "id": "yabook.comandos",
          "name": "Comandos"
        },
        {
          "id": "yabook.sessoes",
          "name": "Alterações do agente"
        }
      ]
    },
    "configuration": {
      "title": "YABook",
      "properties": {
        "yabook.diffsDir": {
          "type": "string",
          "default": "",
          "description": "Pasta das sessões de diff. Vazio usa YABOOK_DIFFS ou ~/.config/yabook/diffs."
        },
        "yabook.scriptsDir": {
          "type": "string",
          "default": "",
          "description": "Pasta skills/yabook/scripts do YABook instalado. Vazio: sessão de diff mais recente, plugin do Claude ou cópia mais nova em ~/.local/share/yabook/plugins."
        },
        "yabook.python": {
          "type": "string",
          "default": "python3",
          "description": "Interpretador usado para iniciar o site do Tasks e o mapa de memória."
        },
        "yabook.tasksPort": {
          "type": "number",
          "default": 0,
          "description": "Porta do YABook Tasks. 0 usa tasks.port da configuração do YABook ou 8765."
        },
        "yabook.memoryMapPort": {
          "type": "number",
          "default": 8766,
          "description": "Porta do mapa de memória; diferente da do Tasks para os dois abrirem juntos."
        }
      }
    }
  }
}
